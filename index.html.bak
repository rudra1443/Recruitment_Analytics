d here can help hiring managers and HR professionals identify bottlenecks, evaluate candidate performance, and enhance decision-making in the recruitment process. The dataset is synthetic, designed for testing and analytical purposes, and provides an ideal platform for practicing SQL queries and building BI dashboards.","domain":"hr","shape":"transactional","useCases":["test-fixtures","bi-dashboards"],"keywords":["recruitment","candidates","job openings","applications","interviews","offers","HR","pipeline"],"locale":"en","license":"CC0-1.0","version":1,"tables":{"job_openings":{"description":"Each row represents a job opening in the organization, linked to multiple applications from candidates.","rows":100,"columns":{"id":{"kind":"pk","description":"Unique identifier for the job opening."},"title":{"kind":"title","description":"Title of the job opening.","nullable":true,"pool":["engineer","architect","lead","associate","intern","representative","scientist","administrator","officer","manager","executive","analyst","coordinator","specialist","consultant","director","developer","strategist","researcher","designer","agent","supervisor","trainer","technician","project","program","data","operations","sales","marketing","human","resource","business","finance","customer","support","quality","safety","logistics","production","communications","policy","regulatory"],"min":1,"max":3},"department":{"kind":"enum","values":["Engineering","Marketing","Sales","HR"],"description":"Department where the job opening is located."},"created_at":{"kind":"datetime","from":"2022-01-01","to":"2023-12-31","description":"Date and time when the job opening was created.","dayProfile":"business"},"status":{"kind":"enum","values":["Open","Closed"],"description":"Current status of the job opening.","weights":[7,3]}}},"candidates":{"description":"Each row represents a candidate applying for jobs, linked to their applications.","rows":200,"columns":{"id":{"kind":"pk","description":"Unique identifier for the candidate."},"full_name":{"kind":"fullName","description":"Full name of the candidate."},"email":{"kind":"email","from":"full_name","description":"Email address of the candidate."},"applied_at":{"kind":"datetime","from":"2022-01-01","to":"2023-12-31","description":"Date and time when the candidate applied.","dayProfile":"waking"}}},"applications":{"description":"Each row represents an application made by a candidate for a job opening, linking candidates to job openings.","rows":{"per":"candidates","via":"candidate_id","min":1,"max":5,"skew":"long-tail"},"columns":{"id":{"kind":"pk","description":"Unique identifier for the application."},"candidate_id":{"kind":"fk","ref":"candidates.id","description":"Reference to the candidate applying."},"job_opening_id":{"kind":"fk","ref":"job_openings.id","description":"Reference to the job opening applied for."},"status":{"kind":"enum","values":["Applied","Interviewing","Offer","Rejected"],"description":"Current status of the application.","weights":[5,4,2,1]},"applied_at":{"kind":"datetime","from":"2022-01-01","to":"2023-12-31","description":"Date of application.","dayProfile":"waking"},"application_date":{"kind":"datetime","from":"2022-01-01","to":"2023-12-31","description":"Date when the application was submitted."},"interview_count":{"kind":"int","min":0,"max":3,"distribution":"normal","description":"Number of interviews conducted for this application."},"candidate_rating":{"kind":"int","min":1,"max":5,"distribution":"high","nullable":true,"description":"Rating given to the candidate by the interviewer; null if not rated."}}},"interviews":{"description":"Each row captures an interview conducted for an application, linked to candidates and interviewers.","rows":{"per":"applications","via":"application_id","min":1,"max":3,"skew":"long-tail"},"columns":{"id":{"kind":"pk","description":"Unique identifier for the interview."},"application_id":{"kind":"fk","ref":"applications.id","description":"Reference to the application being interviewed."},"interviewer":{"kind":"fullName","description":"Name of the interviewer conducting the interview.","nullable":true},"score":{"kind":"int","min":1,"max":10,"description":"Score given by the interviewer for the interview.","nullable":true,"distribution":"high"},"interviewed_at":{"kind":"datetime","from":"2022-01-01","to":"2023-12-31","description":"Date and time of the interview.","dayProfile":"business"}}},"offers":{"description":"Each row represents an offer made to a candidate, linked to their application.","rows":{"per":"applications","via":"application_id","min":0,"max":1,"skew":"long-tail"},"columns":{"id":{"kind":"pk","description":"Unique identifier for the offer."},"application_id":{"kind":"fk","ref":"applications.id","description":"Reference to the application for which the offer is made."},"offer_status":{"kind":"enum","values":["Accepted","Declined"],"description":"Status of the offer made to the candidate.","weights":[6,2]},"offered_at":{"kind":"datetime","from":"2022-01-01","to":"2023-12-31","description":"Date when the offer was made.","nullable":true,"when":{"column":"offer_status","in":["Accepted"]},"dayProfile":"business"},"salary":{"kind":"decimal","min":50000,"max":200000,"scale":2,"description":"Salary offered to the candidate.","nullable":true,"distribution":"long-tail"}}}},"structure":"multi-table","traits":["timestamped","categorical","nullable"],"analysisQuestions":["How many candidates have been interviewed for each job opening?","What is the average score given by interviewers?","Which job openings have the highest acceptance rate of offers?","What is the average time taken from application to offer?","How does the number of applications vary by department?"],"suggestedQueries":[{"title":"Join Candidates and Applications","sql":"SELECT c.full_name, a.status FROM candidates c JOIN applications a ON c.id = a.candidate_id;","dialect":"postgres"},{"title":"Count Applications by Job Opening","sql":"SELECT j.title, COUNT(a.id) as application_count FROM job_openings j LEFT JOIN applications a ON j.id = a.job_opening_id GROUP BY j.id;","dialect":"postgres"},{"title":"Average Interview Score per Job Opening","sql":"SELECT j.title, AVG(i.score) as average_score FROM job_openings j JOIN applications a ON j.id = a.job_opening_id JOIN interviews i ON a.id = i.application_id GROUP BY j.id;","dialect":"postgres"},{"title":"Time from Application to Offer","sql":"SELECT a.id, EXTRACT(DAY FROM o.offered_at - a.applied_at) as days_to_offer FROM applications a JOIN offers o ON a.id = o.application_id;","dialect":"postgres"}],"usageScenarios":[{"title":"HR Analytics Dashboard","body":"A human resources team can utilize this dataset to build a dashboard that visualizes the recruitment pipeline, tracking metrics such as the number of applications per job opening, interview scores, and offer acceptance rates. This dashboard can help identify trends and improve recruitment strategies."},{"title":"Candidate Performance Evaluation","body":"Recruiters can use the data to evaluate candidate performance by analyzing interview scores and the progression of candidates through the various stages of the application process. This can help in understanding which candidate profiles are most successful."},{"title":"Recruitment Process Optimization","body":"By exploring the relationships between job openings, applications, and offers, HR managers can identify bottlenecks in the recruitment process, such as long wait times for interviews or low offer acceptance rates, and adjust their strategies accordingly."},{"title":"Training for Recruiters","body":"Training programs for new recruiters can use this dataset to simulate real-world scenarios in recruitment. They can practice SQL queries to extract insights, helping them understand how to manage candidate data effectively."}]},"dictionary":[{"table":"job_openings","description":"Each row represents a job opening in the organization, linked to multiple applications from candidates.","columns":[{"name":"id","type":"integer","flags":["primary key"],"generator":"sequential id","description":"Unique identifier for the job opening."},{"name":"title","type":"varchar(120)","flags":["nullable"],"generator":"title","description":"Title of the job opening."},{"name":"department","type":"varchar(11)","flags":[],"generator":"one of Engineering, Marketing, Sales, HR","description":"Department where the job opening is located."},{"name":"created_at","type":"timestamp","flags":[],"generator":"between 2022-01-01 and 2023-12-31","description":"Date and time when the job opening was created."},{"name":"status","type":"varchar(6)","flags":[],"generator":"one of Open, Closed","description":"Current status of the job opening."}]},{"table":"candidates","description":"Each row represents a candidate applying for jobs, linked to their applications.","columns":[{"name":"id","type":"integer","flags":["primary key"],"generator":"sequential id","description":"Unique identifier for the candidate."},{"name":"full_name","type":"varchar(120)","flags":[],"generator":"full name","description":"Full name of the candidate."},{"name":"email","type":"varchar(120)","flags":[],"generator":"email","description":"Email address of the candidate."},{"name":"applied_at","type":"timestamp","flags":[],"generator":"between 2022-01-01 and 2023-12-31","description":"Date and time when the candidate applied."}]},{"table":"applications","description":"Each row represents an application made by a candidate for a job opening, linking candidates to job openings.","columns":[{"name":"id","type":"integer","flags":["primary key"],"generator":"sequential id","description":"Unique identifier for the application."},{"name":"candidate_id","type":"integer","flags":["foreign key"],"generator":"references candidates.id","description":"Reference to the candidate applying."},{"name":"job_opening_id","type":"integer","flags":["foreign key"],"generator":"references job_openings.id","description":"Reference to the job opening applied for."},{"name":"status","type":"varchar(12)","flags":[],"generator":"one of Applied, Interviewing, Offer, Rejected","description":"Current status of the application."},{"name":"applied_at","type":"timestamp","flags":[],"generator":"between 2022-01-01 and 2023-12-31","description":"Date of application."},{"name":"application_date","type":"timestamp","flags":[],"generator":"between 2022-01-01 and 2023-12-31","description":"Date when the application was submitted."},{"name":"interview_count","type":"integer","flags":[],"generator":"integer 0–3","description":"Number of interviews conducted for this application."},{"name":"candidate_rating","type":"integer","flags":["nullable"],"generator":"integer 1–5","description":"Rating given to the candidate by the interviewer; null if not rated."}]},{"table":"interviews","description":"Each row captures an interview conducted for an application, linked to candidates and interviewers.","columns":[{"name":"id","type":"integer","flags":["primary key"],"generator":"sequential id","description":"Unique identifier for the interview."},{"name":"application_id","type":"integer","flags":["foreign key"],"generator":"references applications.id","description":"Reference to the application being interviewed."},{"name":"interviewer","type":"varchar(120)","flags":["nullable"],"generator":"full name","description":"Name of the interviewer conducting the interview."},{"name":"score","type":"integer","flags":["nullable"],"generator":"integer 1–10","description":"Score given by the interviewer for the interview."},{"name":"interviewed_at","type":"timestamp","flags":[],"generator":"between 2022-01-01 and 2023-12-31","description":"Date and time of the interview."}]},{"table":"offers","description":"Each row represents an offer made to a candidate, linked to their application.","columns":[{"name":"id","type":"integer","flags":["primary key"],"generator":"sequential id","description":"Unique identifier for the offer."},{"name":"application_id","type":"integer","flags":["foreign key"],"generator":"references applications.id","description":"Reference to the application for which the offer is made."},{"name":"offer_status","type":"varchar(8)","flags":[],"generator":"one of Accepted, Declined","description":"Status of the offer made to the candidate."},{"name":"offered_at","type":"timestamp","flags":["nullable"],"generator":"between 2022-01-01 and 2023-12-31","description":"Date when the offer was made."},{"name":"salary","type":"numeric(14,2)","flags":["nullable"],"generator":"decimal 50000–200000","description":"Salary offered to the candidate."}]}],"snippets":[{"format":"csv","label":"CSV","command":"curl -O https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/csv/candidates.csv"},{"format":"json","label":"JSON","command":"curl -O https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/recruiting-pipeline.json"},{"format":"sql-postgres","label":"PostgreSQL","command":"curl -sL https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/sql/postgres.sql | psql \"$DATABASE_URL\""},{"format":"sql-mysql","label":"MySQL","command":"curl -sL https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/sql/mysql.sql | mysql -u root -p recruiting_pipeline"},{"format":"sql-mssql","label":"SQL Server","command":"curl -sLo mssql.sql https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/sql/mssql.sql \u0026\u0026 sqlcmd -S localhost -d recruiting_pipeline -i mssql.sql"},{"format":"sql-sqlite","label":"SQLite","command":"curl -sL https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/sql/sqlite.sql | sqlite3 recruiting-pipeline.db"},{"format":"prisma-seed","label":"Prisma","command":"curl -sLo prisma/seed.ts https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/prisma/seed.ts \u0026\u0026 npx prisma db seed"},{"format":"django-fixture","label":"Django","command":"curl -sLo recruiting-pipeline.json https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/django/fixtures.json \u0026\u0026 python manage.py loaddata recruiting-pipeline.json"},{"format":"pandas","label":"pandas (Colab, Jupyter)","command":"import pandas as pd\n\ntables = {\n    \"candidates\": pd.read_csv(\"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/csv/candidates.csv\"),\n    \"job_openings\": pd.read_csv(\"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/csv/job_openings.csv\"),\n    \"applications\": pd.read_csv(\"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/csv/applications.csv\"),\n    \"interviews\": pd.read_csv(\"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/csv/interviews.csv\"),\n    \"offers\": pd.read_csv(\"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v4/csv/offers.csv\"),\n}"},{"format":"api","label":"REST API","command":"curl \"https://databasesample.com/api/v1/datasets/recruiting-pipeline/tables/candidates/rows?limit=100\""}],"er":"erDiagram\n    %% Recruiting Pipeline: the tables its SQL files create.\n\n    job_openings {\n        integer id PK \"Unique identifier for the job opening.\"\n        varchar title \"Title of the job opening.\"\n        varchar department \"Department where the job opening is located.\"\n        timestamp created_at \"Date and time when the job opening was created.\"\n        varchar status \"Current status of the job opening.\"\n    }\n\n    candidates {\n        integer id PK \"Unique identifier for the candidate.\"\n        varchar full_name \"Full name of the candidate.\"\n        varchar email \"Email address of the candidate.\"\n        timestamp applied_at \"Date and time when the candidate applied.\"\n    }\n\n    applications {\n        integer id PK \"Unique identifier for the application.\"\n        integer candidate_id FK \"Reference to the candidate applying.\"\n        integer job_opening_id FK \"Reference to the job opening applied for.\"\n        varchar status \"Current status of the application.\"\n        timestamp applied_at \"Date of application.\"\n        timestamp application_date \"Date when the application was submitted.\"\n        integer interview_count \"Number of interviews conducted for this application.\"\n        integer candidate_rating \"Rating given to the candidate by the interviewer; null if not rated.\"\n    }\n\n    interviews {\n        integer id PK \"Unique identifier for the interview.\"\n        integer application_id FK \"Reference to the application being interviewed.\"\n        varchar interviewer \"Name of the interviewer conducting the interview.\"\n        integer score \"Score given by the interviewer for the interview.\"\n        timestamp interviewed_at \"Date and time of the interview.\"\n    }\n\n    offers {\n        integer id PK \"Unique identifier for the offer.\"\n        integer application_id FK \"Reference to the application for which the offer is made.\"\n        varchar offer_status \"Status of the offer made to the candidate.\"\n        timestamp offered_at \"Date when the offer was made.\"\n        numeric salary \"Salary offered to the candidate.\"\n    }\n\n    applications ||--|{ interviews : \"has\"\n    applications ||--|{ offers : \"has\"\n    candidates ||--|{ applications : \"has\"\n    job_openings ||--|{ applications : \"has\"\n","earlier":[{"version":3,"manifestUrl":"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v3/manifest.json"},{"version":2,"manifestUrl":"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v2/manifest.json"},{"version":1,"manifestUrl":"https://database-sample-website.s3.eu-north-1.amazonaws.com/datasets/recruiting-pipeline/v1/manifest.json"}],"practice":[],"tuning":[],"locales":[],"related":[{"slug":"candidate-journey-insights","title":"Recruitment candidates, job postings, interviews and rejection reasons dataset","summary":"Candidate demographics, job postings, interview evaluations, and rejection reasons from recruitment agencies."},{"slug":"job-board-applications-and-interviews-dataset","title":"Job board applications and interviews dataset","summary":"Seventy job postings, applicants, applications and the dated stages each application reached, interviews included."},{"slug":"hr-sample-database","title":"HR sample database","summary":"Employees, departments, jobs and grades, attendance, payroll and payslips, leave, benefits, reviews and hiring."},{"slug":"org-chart","title":"Organization Chart","summary":"A synthetic dataset modeling an organizational hierarchy."},{"slug":"blockchain-based-voting-transparency-tool","title":"Voting Transparency Dataset","summary":"A synthetic dataset modeling interactions in democratic voting processes."},{"slug":"etl-job-runs-task-dependencies-and-lineage","title":"ETL job runs, task dependencies and lineage","summary":"Six daily pipelines of five tasks over four weeks, with rows moved, failures, a task graph and dataset lineage."}],"topic":{"id":"people-and-public-sector","label":"People and public sector"}},"__N_SSG":true},"page":"/datasets/[slug]","query":{"slug":"recruiting-pipeline"},"buildId":"srr0p-sN20P1I0uqk0-d2","isFallback":false,"isExperimentalCompile":false,"gsp":true,"scriptLoader":[]}</script></body></html>