>2023-05-03 17:04:17</td><td>3</td><td>5</td></tr><tr><td>7</td><td>185</td><td>58</td><td>Applied</td><td>2022-04-02 14:04:08</td><td>2022-11-11 04:42:48</td><td>1</td><td>1</td></tr><tr><td>8</td><td>30</td><td>61</td><td>Applied</td><td>2023-07-08 13:57:11</td><td>2023-09-12 21:59:58</td><td>1</td><td>1</td></tr><tr><td>9</td><td>136</td><td>54</td><td>Applied</td><td>2022-03-12 17:10:15</td><td>2022-05-13 01:39:22</td><td>2</td><td>5</td></tr><tr><td>10</td><td>3</td><td>84</td><td>Offer</td><td>2022-07-02 10:26:58</td><td>2022-03-25 01:06:34</td><td>2</td><td>1</td></tr></tbody></table></div></div><div><h3>interviews</h3><div class="dataset-table-wrap"><table><caption class="visually-hidden">First rows of interviews</caption><thead><tr><th scope="col">id</th><th scope="col">application_id</th><th scope="col">interviewer</th><th scope="col">score</th><th scope="col">interviewed_at</th></tr></thead><tbody><tr><td>1</td><td>203</td><td>Sara Ruiz</td><td>10</td><td>2022-02-07 10:51:27</td></tr><tr><td>2</td><td>261</td><td>Ibrahim Taylor</td><td>3</td><td>2023-09-15 11:28:00</td></tr><tr><td>3</td><td>25</td><td>Kai Diaz</td><td>10</td><td>2022-08-30 10:26:30</td></tr><tr><td>4</td><td>88</td><td class="is-null">null</td><td>10</td><td>2022-11-17 12:54:28</td></tr><tr><td>5</td><td>55</td><td>Ivan Hoffmann</td><td>8</td><td>2022-09-15 15:37:54</td></tr><tr><td>6</td><td>100</td><td>Hugo Sato</td><td>9</td><td>2022-03-23 11:27:31</td></tr><tr><td>7</td><td>30</td><td>Elena Nguyen</td><td>2</td><td>2023-07-31 09:28:15</td></tr><tr><td>8</td><td>316</td><td>Karim Rossi</td><td class="is-null">null</td><td>2023-09-20 17:53:02</td></tr><tr><td>9</td><td>228</td><td>Sven Larsen</td><td>4</td><td>2023-12-04 09:54:30</td></tr><tr><td>10</td><td>266</td><td>Amir Baker</td><td>9</td><td>2023-10-22 12:11:03</td></tr></tbody></table></div></div><div><h3>offers</h3><div class="dataset-table-wrap"><table><caption class="visually-hidden">First rows of offers</caption><thead><tr><th scope="col">id</th><th scope="col">application_id</th><th scope="col">offer_status</th><th scope="col">offered_at</th><th scope="col">salary</th></tr></thead><tbody><tr><td>1</td><td>211</td><td>Declined</td><td class="is-null">null</td><td>90637.16</td></tr><tr><td>2</td><td>325</td><td>Accepted</td><td>2023-10-05 15:03:39</td><td>60449.52</td></tr><tr><td>3</td><td>5</td><td>Accepted</td><td>2023-05-27 12:02:47</td><td>74191.58</td></tr><tr><td>4</td><td>271</td><td>Accepted</td><td>2023-12-27 12:39:06</td><td>107752.59</td></tr><tr><td>5</td><td>19</td><td>Accepted</td><td>2023-09-15 14:27:48</td><td>50471.20</td></tr><tr><td>6</td><td>26</td><td>Accepted</td><td>2022-09-23 23:22:18</td><td>53639.78</td></tr><tr><td>7</td><td>189</td><td>Accepted</td><td>2022-12-31 08:13:19</td><td class="is-null">null</td></tr><tr><td>8</td><td>153</td><td>Accepted</td><td>2022-07-12 14:16:21</td><td>151906.62</td></tr><tr><td>9</td><td>144</td><td>Declined</td><td class="is-null">null</td><td>126166.86</td></tr><tr><td>10</td><td>503</td><td>Accepted</td><td>2022-06-02 14:05:12</td><td>52692.53</td></tr></tbody></table></div></div></section><section class="dataset-section" id="embed"><h2>Embed it</h2><p class="p-sm">The preview above, in a frame for a blog post, a course page or documentation: one table at a time with its CSV, and a link back here for every other format. Add <code>?table=</code> and a table name to open on that table.</p><div class="dataset-snippet"><h3>HTML</h3><pre><code>&lt;iframe src=&quot;https://databasesample.com/embed/dataset/recruiting-pipeline&quot; width=&quot;100%&quot; height=&quot;460&quot; style=&quot;border:1px solid #e4e7ec;border-radius:8px&quot; title=&quot;Recruiting Pipeline — sample dataset&quot; loading=&quot;lazy&quot;&gt;&lt;/iframe&gt;</code></pre><button type="button" aria-label="Copy the HTML command">Copy</button></div></section><section class="dataset-section" id="questions"><h2>Questions to ask of it</h2><ul class="dataset-questions"><li>How many candidates have been interviewed for each job opening?</li><li>What is the average score given by interviewers?</li><li>Which job openings have the highest acceptance rate of offers?</li><li>What is the average time taken from application to offer?</li><li>How does the number of applications vary by department?</li></ul></section><section class="dataset-section" id="queries"><h2>Queries worth running</h2><div class="dataset-snippet"><h3>Join Candidates and Applications</h3><pre><code>SELECT c.full_name, a.status FROM candidates c JOIN applications a ON c.id = a.candidate_id;</code></pre></div><div class="dataset-snippet"><h3>Count Applications by Job Opening</h3><pre><code>SELECT j.title, COUNT(a.id) as application_count FROM job_openings j LEFT JOIN applications a ON j.id = a.job_opening_id GROUP BY j.id;</code></pre></div><div class="dataset-snippet"><h3>Average Interview Score per Job Opening</h3><pre><code>SELECT j.title, AVG(i.score) as average_score FROM job_openings j JOIN applications a ON j.id = a.job_opening_id JOIN interviews i ON a.id = i.application_id GROUP BY j.id;</code></pre></div><div class="dataset-snippet"><h3>Time from Application to Offer</h3><pre><code>SELECT a.id, EXTRACT(DAY FROM o.offered_at - a.applied_at) as days_to_offer FROM applications a JOIN offers o ON a.id = o.application_id;</code></pre></div></section><section class="dataset-section" id="uses"><h2>What to do with it</h2><div><h3>HR Analytics Dashboard</h3><p>A human resources team can utilize this dataset to build a dashboard that visualizes the recruitment pipeline, tracking metrics such as the number of applications per job opening, interview scores, and offer acceptance rates. This dashboard can help identify trends and improve recruitment strategies.</p></div><div><h3>Candidate Performance Evaluation</h3><p>Recruiters can use the data to evaluate candidate performance by analyzing interview scores and the progression of candidates through the various stages of the application process. This can help in understanding which candidate profiles are most successful.</p></div><div><h3>Recruitment Process Optimization</h3><p>By exploring the relationships between job openings, applications, and offers, HR managers can identify bottlenecks in the recruitment process, such as long wait times for interviews or low offer acceptance rates, and adjust their strategies accordingly.</p></div><div><h3>Training for Recruiters</h3><p>Training programs for new recruiters can use this dataset to simulate real-world scenarios in recruitment. They can practice SQL queries to extract insights, helping them understand how to manage candidate data effectively.</p></div></section><section class="dataset-section" id="related" aria-labelledby="related-title"><h2 id="related-title">Related datasets</h2><ul class="dataset-related"><li><a href="/datasets/candidate-journey-insights">Recruitment candidates, job postings, interviews and rejection reasons dataset</a><span> — <!-- -->Candidate demographics, job postings, interview evaluations, and rejection reasons from recruitment agencies.</span></li><li><a href="/datasets/job-board-applications-and-interviews-dataset">Job board applications and interviews dataset</a><span> — <!-- -->Seventy job postings, applicants, applications and the dated stages each application reached, interviews included.</span></li><li><a href="/datasets/hr-sample-database">HR sample database</a><span> — <!-- -->Employees, departments, jobs and grades, attendance, payroll and payslips, leave, benefits, reviews and hiring.</span></li><li><a href="/datasets/org-chart">Organization Chart</a><span> — <!-- -->A synthetic dataset modeling an organizational hierarchy.</span></li><li><a href="/datasets/blockchain-based-voting-transparency-tool">Voting Transparency Dataset</a><span> — <!-- -->A synthetic dataset modeling interactions in democratic voting processes.</span></li><li><a href="/datasets/etl-job-runs-task-dependencies-and-lineage">ETL job runs, task dependencies and lineage</a><span> — <!-- -->Six daily pipelines of five tasks over four weeks, with rows moved, failures, a task graph and dataset lineage.</span></li></ul></section><section class="dataset-section" id="limitations"><h2>What this data is, and is not</h2><div class="dataset-limits"><p>Every row is synthetic. Names, cities and companies come from short word lists, every email lands on an <code>example.com</code> domain and every phone number is in the block reserved for fiction — you will see the repeats within a few hundred rows, and that is deliberate. No row describes a real person or a real company.</p><p>Distributions are plausible, not measured: order counts are long-tailed, statuses are weighted, timestamps are ordered. Nothing was sampled from anything real, and no column carries a relationship the spec did not spell out — an order has no total computed from its items, because working that out is the exercise.</p><p>One size: at most 1,000 rows per table. Enough for a seed, a demo or a lesson; not a benchmark. The files are generated deterministically, so a given version is byte-identical for everyone.</p></div></section><aside class="studio-callout"><h2>Need a different dataset?</h2><p>Describe the data you need and the Dataset Studio generates a set for it, with related tables and foreign keys, in the same formats.</p><a class="studio-callout-action" href="/datasets/studio">Open the Dataset Studio</a></aside></article></div></div></main><footer class="footer-area"><div class="container"><div class="row"><div class="col-lg-4 col-sm-6"><div class="single-footer-widget"><a class="logo" aria-label="Database Sample" href="/"><svg width="38" height="38" viewBox="0 0 24 24" class="brand-mark" aria-hidden="true" focusable="false"><path d="M8.2 3H3v5.2M15.8 3H21v5.2M21 15.8V21h-5.2M8.2 21H3v-5.2" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"></path><rect x="8.4" y="8.4" width="3.3" height="3.3" rx="0.9" fill="currentColor"></rect><rect x="12.9" y="8.4" width="3.3" height="3.3" rx="0.9" fill="currentColor" opacity="0.3"></rect><rect x="8.4" y="12.9" width="3.3" height="3.3" rx="0.9" fill="currentColor" opacity="0.3"></rect><rect x="12.9" y="12.9" width="3.3" height="3.3" rx="0.9" fill="var(--brand-accent, #006fde)"></rect></svg><span class="brand-word"><span>database</span><span class="brand-word-accent">sample</span></span></a><p>Database schemas, sample data and the tools to edit them.</p><ul class="social-link"><li><a class="d-block" target="_blank" rel="noopener noreferrer" href="https://x.com/databasesample"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" class="" style="vertical-align:-0.125em" role="img" aria-label="X" focusable="false"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93zm-1.29 19.5h2.04L6.49 3.24H4.3z"></path></svg></a></li><li><a class="d-block" target="_blank" rel="noopener noreferrer" href="https://www.instagram.com/databasesample"><svg viewBox="0 0 24 24" width="1em" height="1em" fill="currentColor" class="" style="vertical-align:-0.125em" role="img" aria-label="Instagram" focusable="false"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.89 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07c-4.36.2-6.78 2.62-6.98 6.98C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0m0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8m6.41-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88"></pat