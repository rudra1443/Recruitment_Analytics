 Recruiting Pipeline","description":"Each row represents a job opening in the organization, linked to multiple applications from candidates. Part of Recruiting Pipeline: Job openings, candidates, applications, interviews, and offer outcomes from a recruiting pipeline.","url":"https://databasesample.com/datasets/recruiting-pipeline/t/job_openings","creator":{"@type":"Organization","name":"Database Sample","url":"https://databasesample.com"},"isAccessibleForFree":true,"license":"https://creativecommons.org/publicdomain/zero/1.0/"},{"@type":"Dataset","@id":"https://databasesample.com/datasets/recruiting-pipeline/t/applications#dataset","name":"applications — Recruiting Pipeline","description":"Each row represents an application made by a candidate for a job opening, linking candidates to job openings. Part of Recruiting Pipeline: Job openings, candidates, applications, interviews, and offer outcomes from a recruiting pipeline.","url":"https://databasesample.com/datasets/recruiting-pipeline/t/applications","creator":{"@type":"Organization","name":"Database Sample","url":"https://databasesample.com"},"isAccessibleForFree":true,"license":"https://creativecommons.org/publicdomain/zero/1.0/"},{"@type":"Dataset","@id":"https://databasesample.com/datasets/recruiting-pipeline/t/interviews#dataset","name":"interviews — Recruiting Pipeline","description":"Each row captures an interview conducted for an application, linked to candidates and interviewers. Part of Recruiting Pipeline: Job openings, candidates, applications, interviews, and offer outcomes from a recruiting pipeline.","url":"https://databasesample.com/datasets/recruiting-pipeline/t/interviews","creator":{"@type":"Organization","name":"Database Sample","url":"https://databasesample.com"},"isAccessibleForFree":true,"license":"https://creativecommons.org/publicdomain/zero/1.0/"},{"@type":"Dataset","@id":"https://databasesample.com/datasets/recruiting-pipeline/t/offers#dataset","name":"offers — Recruiting Pipeline","description":"Each row represents an offer made to a candidate, linked to their application. Part of Recruiting Pipeline: Job openings, candidates, applications, interviews, and offer outcomes from a recruiting pipeline.","url":"https://databasesample.com/datasets/recruiting-pipeline/t/offers","creator":{"@type":"Organization","name":"Database Sample","url":"https://databasesample.com"},"isAccessibleForFree":true,"license":"https://creativecommons.org/publicdomain/zero/1.0/"}]}</script><script type="application/ld+json" data-next-head="">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Dataset Repo","item":"https://databasesample.com/datasets"},{"@type":"ListItem","position":2,"name":"Recruiting Pipeline","item":"https://databasesample.com/datasets/recruiting-pipeline"}]}</script><meta charSet="utf-8"/><script>(function(){try{var t=localStorage.getItem('ds:theme');if(t!=='light'&&t!=='dark'){t=localStorage.getItem('theme')==='dark'?'dark':(window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')}document.documentElement.dataset.theme=t}catch(e){}})();</script><link rel="icon" href="/favicon.svg" type="image/svg+xml"/><link rel="icon" href="/favicon.ico" sizes="48x48"/><link rel="apple-touch-icon" href="/img/brand/apple-touch-icon.png"/><link rel="manifest" href="/manifest.webmanifest"/><meta name="theme-color" content="#006fde"/><link rel="preconnect" href="https://database-sample-website.s3.eu-north-1.amazonaws.com"/><link rel="dns-prefetch" href="https://www.googletagmanager.com"/><link rel="preload" href="/_next/static/media/26d4368bf94c0ec4-s.p.woff2" as="font" type="font/woff2" crossorigin="anonymous" data-next-font="size-adjust"/><link rel="preload" href="/_next/static/css/506751c47cd30828.css" as="style"/><link rel="stylesheet" href="/_next/static/css/506751c47cd30828.css" data-n-g=""/><noscript data-n-css=""></noscript><script defer="" nomodule="" src="/_next