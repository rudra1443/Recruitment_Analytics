{
  "format": "dataset-manifest/1",
  "slug": "recruiting-pipeline",
  "version": 4,
  "seed": "recruiting-pipeline:1",
  "engine": 1,
  "engineVersion": "1.0.0",
  "spec": {
    "format": "dataset/1",
    "slug": "recruiting-pipeline",
    "name": "Recruiting Pipeline",
    "tagline": "Job openings, candidates, applications, interviews, and offer outcomes from a recruiting pipeline.",
    "description": "Recruiting is a critical process in any organization, and understanding the flow from job openings to candidate offers is essential for optimizing hiring strategies. This synthetic dataset captures various aspects of the recruiting pipeline, including job openings, candidates, applications, interview details, and final offer statuses. Each table is interconnected, allowing for comprehensive analyses of recruitment metrics and candidate journey stages. The data modeled here can help hiring managers and HR professionals identify bottlenecks, evaluate candidate performance, and enhance decision-making in the recruitment process. The dataset is synthetic, designed for testing and analytical purposes, and provides an ideal platform for practicing SQL queries and building BI dashboards.",
    "domain": "hr",
    "shape": "transactional",
    "useCases": [
      "test-fixtures",
      "bi-dashboards"
    ],
    "keywords": [
      "recruitment",
      "candidates",
      "job openings",
      "applications",
      "interviews",
      "offers",
      "HR",
      "pipeline"
    ],
    "locale": "en",
    "license": "CC0-1.0",
    "version": 1,
    "tables": {
      "job_openings": {
        "description": "Each row represents a job opening in the organization, linked to multiple applications from candidates.",
        "rows": 100,
        "columns": {
          "id": {
            "kind": "pk",
            "description": "Unique identifier for the job opening."
          },
          "title": {
            "kind": "title",
            "description": "Title of the job opening.",
            "nullable": true,
            "pool": [
              "engineer",
              "architect",
              "lead",
              "associate",
              "intern",
              "representative",
              "scientist",
              "administrator",
              "officer",
              "manager",
              "executive",
              "analyst",
              "coordinator",
              "specialist",
              "consultant",
              "director",
              "developer",
              "strategist",
              "researcher",
              "designer",
              "agent",
              "supervisor",
              "trainer",
              "technician",
              "project",
              "program",
              "data",
              "operations",
              "sales",
              "marketing",
              "human",
              "resource",
              "business",
              "finance",
              "customer",
              "support",
              "quality",
              "safety",
              "logistics",
              "production",
              "communications",
              "policy",
              "regulatory"
            ],
            "min": 1,
            "max": 3
          },
          "department": {
            "kind": "enum",
            "values": [
              "Engineering",
              "Marketing",
              "Sales",
              "HR"
            ],
            "description": "Department where the job opening is located."
          },
          "created_at": {
            "kind": "datetime",
            "from": "2022-01-01",
            "to": "2023-12-31",
            "description": "Date and time when the job opening was created.",
            "dayProfile": "business"
          },
          "status": {
            "kind": "enum",
            "values": [
              "Open",
              "Closed"
            ],
            "description": "Current status of the job opening.",
            "weights": [
              7,
              3
            ]
          }
        }
      },
      "candidates": {
        "description": "Each row represents a candidate applying for jobs, linked to their applications.",
        "rows": 200,
        "columns": {
          "id": {
            "kind": "pk",
            "description": "Unique identifier for the candidate."
          },
          "full_name": {
            "kind": "fullName",
            "description": "Full name of the candidate."
          },
          "email": {
            "kind": "email",
            "from": "full_name",
            "description": "Email address of the candidate."
          },
          "applied_at": {
            "kind": "datetime",
            "from": "2022-01-01",
            "to": "2023-12-31",
            "description": "Date and time when the candidate applied.",
            "dayProfile": "waking"
          }
        }
      },
      "applications": {
        "description": "Each row represents an application made by a candidate for a job opening, linking candidates to job openings.",
        "rows": {
          "per": "candidates",
          "via": "candidate_id",
          "min": 1,
          "max": 5,
          "skew": "long-tail"
        },
        "columns": {
          "id": {
            "kind": "pk",
            "description": "Unique identifier for the application."
          },
          "candidate_id": {
            "kind": "fk",
            "ref": "candidates.id",
            "description": "Reference to the candidate applying."
          },
          "job_opening_id": {
            "kind": "fk",
            "ref": "job_openings.id",
            "description": "Reference to the job opening applied for."
          },
          "status": {
            "kind": "enum",
            "values": [
              "Applied",
              "Interviewing",
              "Offer",
              "Rejected"
            ],
            "description": "Current status of the application.",
            "weights": [
              5,
              4,
              2,
              1
            ]
          },
          "applied_at": {
            "kind": "datetime",
            "from": "2022-01-01",
            "to": "2023-12-31",
            "description": "Date of application.",
            "dayProfile": "waking"
          },
          "application_date": {
            "kind": "datetime",
            "from": "2022-01-01",
            "to": "2023-12-31",
            "description": "Date when the application was submitted."
          },
          "interview_count": {
            "kind": "int",
            "min": 0,
            "max": 3,
            "distribution": "normal",
            "description": "Number of interviews conducted for this application."
          },
          "candidate_rating": {
            "kind": "int",
            "min": 1,
            "max": 5,
            "distribution": "high",
            "nullable": true,
            "description": "Rating given to the candidate by the interviewer; null if not rated."
          }
        }
      },
      "interviews": {
        "description": "Each row captures an interview conducted for an application, linked to candidates and interviewers.",
        "rows": {
          "per": "applications",
          "via": "application_id",
          "min": 1,
          "max": 3,
          "skew": "long-tail"
        },
        "columns": {
          "id": {
            "kind": "pk",
            "description": "Unique identifier for the interview."
          },
          "application_id": {
            "kind": "fk",
            "ref": "applications.id",
            "description": "Reference to the application being interviewed."
          },
          "interviewer": {
            "kind": "fullName",
            "description": "Name of the interviewer conducting the interview.",
            "nullable": true
          },
          "score": {
            "kind": "int",
            "min": 1,
            "max": 10,
            "description": "Score given by the interviewer for the interview.",
            "nullable": true,
            "distribution": "high"
          },
          "interviewed_at": {
            "kind": "datetime",
            "from": "2022-01-01",
            "to": "2023-12-31",
            "description": "Date and time of the interview.",
            "dayProfile": "business"
          }
        }
      },
      "offers": {
        "description": "Each row represents an offer made to a candidate, linked to their application.",
        "rows": {
          "per": "applications",
          "via": "application_id",
          "min": 0,
          "max": 1,
          "skew": "long-tail"
        },
        "columns": {
          "id": {
            "kind": "pk",
            "description": "Unique identifier for the offer."
          },
          "application_id": {
            "kind": "fk",
            "ref": "applications.id",
            "description": "Reference to the application for which the offer is made."
          },
          "offer_status": {
            "kind": "enum",
            "values": [
              "Accepted",
              "Declined"
            ],
            "description": "Status of the offer made to the candidate.",
            "weights": [
              6,
              2
            ]
          },
          "offered_at": {
            "kind": "datetime",
            "from": "2022-01-01",
            "to": "2023-12-31",
            "description": "Date when the offer was made.",
            "nullable": true,
            "when": {
              "column": "offer_status",
              "in": [
                "Accepted"
              ]
            },
            "dayProfile": "business"
          },
          "salary": {
            "kind": "decimal",
            "min": 50000,
            "max": 200000,
            "scale": 2,
            "description": "Salary offered to the candidate.",
            "nullable": true,
            "distribution": "long-tail"
          }
        }
      }
    },
    "structure": "multi-table",
    "traits": [
      "timestamped",
      "categorical",
      "nullable"
    ],
    "analysisQuestions": [
      "How many candidates have been interviewed for each job opening?",
      "What is the average score given by interviewers?",
      "Which job openings have the highest acceptance rate of offers?",
      "What is the average time taken from application to offer?",
      "How does the number of applications vary by department?"
    ],
    "suggestedQueries": [
      {
        "title": "Join Candidates and Applications",
        "sql": "SELECT c.full_name, a.status FROM candidates c JOIN applications a ON c.id = a.candidate_id;",
        "dialect": "postgres"
      },
      {
        "title": "Count Applications by Job Opening",
        "sql": "SELECT j.title, COUNT(a.id) as application_count FROM job_openings j LEFT JOIN applications a ON j.id = a.job_opening_id GROUP BY j.id;",
        "dialect": "postgres"
      },
      {
        "title": "Average Interview Score per Job Opening",
        "sql": "SELECT j.title, AVG(i.score) as average_score FROM job_openings j JOIN applications a ON j.id = a.job_opening_id JOIN interviews i ON a.id = i.application_id GROUP BY j.id;",
        "dialect": "postgres"
      },
      {
        "title": "Time from Application to Offer",
        "sql": "SELECT a.id, EXTRACT(DAY FROM o.offered_at - a.applied_at) as days_to_offer FROM applications a JOIN offers o ON a.id = o.application_id;",
        "dialect": "postgres"
      }
    ],
    "usageScenarios": [
      {
        "title": "HR Analytics Dashboard",
        "body": "A human resources team can utilize this dataset to build a dashboard that visualizes the recruitment pipeline, tracking metrics such as the number of applications per job opening, interview scores, and offer acceptance rates. This dashboard can help identify trends and improve recruitment strategies."
      },
      {
        "title": "Candidate Performance Evaluation",
        "body": "Recruiters can use the data to evaluate candidate performance by analyzing interview scores and the progression of candidates through the various stages of the application process. This can help in understanding which candidate profiles are most successful."
      },
      {
        "title": "Recruitment Process Optimization",
        "body": "By exploring the relationships between job openings, applications, and offers, HR managers can identify bottlenecks in the recruitment process, such as long wait times for interviews or low offer acceptance rates, and adjust their strategies accordingly."
      },
      {
        "title": "Training for Recruiters",
        "body": "Training programs for new recruiters can use this dataset to simulate real-world scenarios in recruitment. They can practice SQL queries to extract insights, helping them understand how to manage candidate data effectively."
      }
    ]
  },
